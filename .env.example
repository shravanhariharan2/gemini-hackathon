# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional model override for frame-based product detection.
GEMINI_ITEM_MODEL="gemini-3.8-flash"

# Optional JSON array of RTCIceServer objects (e.g. TURN servers for production NAT traversal).
# WEBRTC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]'

# Optional local media binary paths (defaults resolve from PATH).
# FFMPEG_PATH="/opt/homebrew/bin/ffmpeg"
# FFPROBE_PATH="/opt/homebrew/bin/ffprobe"

# Clip editing uses the same Gemini API key; no Vertex AI deployment is needed.
GEMINI_CLIP_EDITOR_MODEL="gemini-3.8-flash"
